<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 車機風格：Material 3 深色 + 藍 accent（幼邊框分格） -->
    <style name="Theme.車機Eq" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/eq_accent</item>
        <item name="colorOnPrimary">@color/eq_on_accent</item>
        <item name="colorPrimaryContainer">@color/eq_accent</item>
        <item name="colorOnPrimaryContainer">@color/eq_on_accent</item>
        <item name="colorSecondary">@color/eq_accent</item>
        <item name="colorOnSecondary">@color/eq_on_accent</item>
        <item name="colorError">@color/eq_danger</item>
        <item name="colorOnError">#FFFFFFFF</item>
        <item name="colorSurface">@color/eq_surface</item>
        <item name="colorOnSurface">@color/eq_text</item>
        <item name="colorSurfaceVariant">@color/eq_surface2</item>
        <item name="colorOnSurfaceVariant">@color/eq_text_dim</item>
        <item name="colorOutline">@color/eq_stroke</item>
        <item name="colorOutlineVariant">@color/eq_stroke</item>
        <item name="android:colorBackground">@color/eq_bg</item>
        <item name="colorOnBackground">@color/eq_text</item>
        <item name="android:statusBarColor">@color/eq_bg</item>
        <item name="android:navigationBarColor">@color/eq_bg</item>
        <item name="android:windowBackground">@color/eq_bg</item>
        <item name="materialButtonStyle">@style/Eq.Button</item>
        <item name="materialCardViewStyle">@style/Eq.Card</item>
    </style>

    <style name="Eq.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/eq_surface2</item>
        <item name="android:textColor">@color/eq_text</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Eq.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/eq_surface</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/eq_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
